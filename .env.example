# Єдине джерело значень для docker-compose. Скопіюй у .env і заповни.
# Середовище перемикається ТІЛЬКИ тут.

ENVIRONMENT=local
COMPOSE_PROJECT_NAME=${ENVIRONMENT}-shved-yoga

# Лише для dev/prod — local це просто база без override-файлів:
# COMPOSE_FILE=docker-compose.yml:docker-compose.${ENVIRONMENT}.yml

# --- сайт ---
# SITE_URL запікається у canonical, og:url і sitemap на етапі збірки.
SITE_URL=http://localhost:8080
SITE_PORT=8080
SITE_IMAGE=shved-yoga-site:local

# Telegram-бот: єдиний канал запису (ADR-0001). Deep link додається на сторінці.
PUBLIC_BOT_URL=https://t.me/olha_shved_yoga_bot

# GA4 у режимі Consent Mode v2 без cookies. Порожнє значення = аналітика не підключається.
PUBLIC_GA4_ID=
