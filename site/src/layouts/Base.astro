---
import "../styles/global.css";
import { meta, kontakty, rozklad } from "../content/site";

interface Props {
  title?: string;
  description?: string;
  /** Страницы вроде /privacy не должны конкурировать с главной в выдаче. */
  noindex?: boolean;
}

const {
  title = meta.title,
  description = meta.description,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ga4 = import.meta.env.PUBLIC_GA4_ID;

// Разметка для локального поиска: адрес партнёрского простору, часы — субота.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  additionalType: "https://schema.org/SportsActivityLocation",
  name: meta.brand,
  description: meta.description,
  url: canonical,
  image: new URL("/og.jpg", Astro.site).href,
  address: {
    "@type": "PostalAddress",
    streetAddress: kontakty.address,
    addressLocality: kontakty.city,
    addressCountry: "UA",
  },
  areaServed: kontakty.city,
  priceRange: "500–2400 ₴",
  currenciesAccepted: "UAH",
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: "https://schema.org/Saturday",
      opens: "12:00",
      closes: "16:00",
    },
  ],
  sameAs: [kontakty.instagram, kontakty.telegram],
  makesOffer: rozklad.prices
    .filter((p) => p.price !== "за запитом")
    .map((p) => ({
      "@type": "Offer",
      name: p.title,
      price: p.price.replace(/[^\d]/g, ""),
      priceCurrency: "UAH",
    })),
};
---

<!doctype html>
<html lang={meta.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={meta.locale} />
    <meta property="og:site_name" content={meta.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {/* Размеры и alt заданы явно: без них Facebook и LinkedIn при первом
        шаринге успевают отрисовать превью до загрузки картинки и обрезают её. */}
    <meta property="og:image" content={new URL("/og.jpg", Astro.site).href} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={meta.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL("/og.jpg", Astro.site).href} />
    <meta name="twitter:image:alt" content={meta.imageAlt} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f5f2ee" />

    <link
      rel="preload"
      href="/fonts/literata-display.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/fixel-text-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {
      ga4 && (
        <>
          {/* Consent Mode v2: analytics_storage запрещён по умолчанию, поэтому
              GA4 работает без cookies и cookie-баннер не нужен. См. landing-spec.md */}
          <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag("consent", "default", {
              ad_storage: "denied",
              ad_user_data: "denied",
              ad_personalization: "denied",
              analytics_storage: "denied",
              wait_for_update: 0,
            });
            gtag("js", new Date());
          </script>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`}
          />
          <script is:inline define:vars={{ ga4 }}>
            gtag("config", ga4, { anonymize_ip: true });
          </script>
        </>
      )
    }
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
    >
      До основного вмісту
    </a>
    <slot />

    <script is:inline>
      // Появление секций. Наблюдатель, а не скролл-хендлер: без работы на каждый кадр.
      (() => {
        const items = document.querySelectorAll(".reveal");
        if (!items.length) return;
        if (
          window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
          !("IntersectionObserver" in window)
        ) {
          items.forEach((el) => el.classList.add("is-visible"));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -12% 0px", threshold: 0.08 },
        );
        items.forEach((el) => io.observe(el));
      })();

      // Активный пункт меню. Признак не только цветом — ещё подчёркиванием:
      // цвет как единственный сигнал не проходит по доступности.
      (() => {
        const links = document.querySelectorAll("[data-nav-link]");
        if (!links.length || !("IntersectionObserver" in window)) return;

        const byId = new Map();
        links.forEach((link) => {
          const id = link.dataset.navLink.replace("#", "");
          const section = document.getElementById(id);
          if (section) byId.set(section, link);
        });
        if (!byId.size) return;

        // Держим множество видимых секций, а не последнюю сработавшую: иначе
        // при возврате на первый экран в меню висит устаревший пункт.
        const visible = new Set();
        const order = [...byId.keys()];
        let current = null;

        const apply = () => {
          const top = order.find((section) => visible.has(section));
          const link = top ? byId.get(top) : null;
          if (link === current) return;
          current?.removeAttribute("aria-current");
          link?.setAttribute("aria-current", "true");
          current = link ?? null;
        };

        const spy = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) visible.add(entry.target);
              else visible.delete(entry.target);
            });
            apply();
          },
          { rootMargin: "-45% 0px -50% 0px" },
        );
        order.forEach((section) => spy.observe(section));
      })();

      // Атрибуция: считаем, какая кнопка увела в бота.
      document.addEventListener("click", (e) => {
        const link = e.target.closest("a[data-cta]");
        if (!link || typeof window.gtag !== "function") return;
        window.gtag("event", "bot_open", {
          placement: link.dataset.cta,
          napriam: link.dataset.napriam || "none",
        });
      });
    </script>
  </body>
</html>
