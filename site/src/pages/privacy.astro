---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { kontakty, meta } from "../content/site";

/**
 * ЧЕРНОВИК. Текст написан как болванка и ждёт вычитки Олі — см. landing-spec.md.
 * Юридически значимые формулировки менять только с её согласия.
 */
const sections = [
  {
    title: "Хто обробляє ваші дані",
    body: [
      "Дані обробляє Ольга Швед, викладачка йоги, яка проводить заняття у Львові. Зв'язатися можна в Telegram або Instagram — посилання внизу сторінки.",
    ],
  },
  {
    title: "Що ми збираємо",
    body: [
      "Коли ви записуєтеся на заняття через Telegram-бота, ми зберігаємо: ваше ім'я, номер телефону, обраний напрям, за бажанням — досвід практики та зручний час, а також те, що ви розповіли про особливості здоров'я чи вагітність.",
      "Дані про самопочуття потрібні лише для одного: щоб адаптувати практику й не зашкодити вам на занятті. Вони не передаються нікому.",
    ],
  },
  {
    title: "Навіщо",
    body: [
      "Щоб підтвердити ваше місце в групі, відповісти на запитання й безпечно провести заняття. Ми не надсилаємо рекламних розсилок і не передаємо ваші дані третім особам.",
    ],
  },
  {
    title: "Скільки зберігаємо",
    body: [
      "Історія ваших звернень зберігається, поки ви не попросите її видалити. Ми робимо так, щоб бачити вашу історію практики й пам'ятати, що для вас важливо.",
    ],
  },
  {
    title: "Як видалити свої дані",
    body: [
      "Напишіть у Telegram або Instagram — ми видалимо все, що про вас зберігається, і підтвердимо це. Жодних причин пояснювати не потрібно.",
    ],
  },
  {
    title: "Статистика сайту",
    body: [
      "Сайт збирає анонімну статистику відвідувань через Google Analytics у режимі без файлів cookie: ми бачимо кількість візитів і джерела переходів, але не ідентифікуємо відвідувачів. Саме тому на сайті немає банера про cookie — ми їх не встановлюємо.",
    ],
  },
];
---

<Base
  title={`Політика конфіденційності — ${meta.brand}`}
  description="Які дані збирає Olha Shved Yoga, навіщо, скільки зберігає і як їх видалити."
  noindex
>
  <Nav />
  <main id="main" class="bg-paper py-16 sm:py-24">
    <div class="mx-auto max-w-[46rem] px-5 sm:px-8">
      <h1 class="text-h2 font-display font-medium text-ink">
        Політика конфіденційності
      </h1>
      <p class="mt-5 font-sans text-body text-taupe">
        Коротко й без юридичного туману: що ми про вас зберігаємо, навіщо і як це
        видалити.
      </p>

      <div class="mt-12 flex flex-col gap-10">
        {
          sections.map((s) => (
            <section>
              <h2 class="text-h3 font-display font-medium text-ink">
                {s.title}
              </h2>
              <div class="mt-3 flex flex-col gap-3 font-sans text-body text-ink/85">
                {s.body.map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            </section>
          ))
        }
      </div>

      <p class="mt-14 border-t border-taupe/25 pt-6 font-sans text-small text-taupe">
        Заняття відбуваються у просторі {kontakty.venue.name},{" "}
        {kontakty.address}, {kontakty.city}.
      </p>
    </div>
  </main>
  <Footer />
</Base>
