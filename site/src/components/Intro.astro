---
import { Image } from "astro:assets";
import { intro } from "../content/site";
import Cta from "./Cta.astro";
import cutout from "../assets/photos/intro-cutout.png";

/**
 * Знайомство. Від md вирізана фігура стоїть тлом, зсунута праворуч, і видна
 * цілком — правий край кадру рівно на межі екрана. На вузькому екрані тло
 * поруч із текстом не вміщається, тому там кадр іде у звичайному потоці: по
 * центру, над привітанням.
 *
 * Нічого поверх кадру не лежить: ні маски, ні підкладки. Тому текст мусить
 * розходитися з фігурою по вертикалі, а не накриватися нею — звідси великий
 * нижній відступ секції, який тримає абзаци над кадром.
 */
---

<section
  class="relative isolate overflow-hidden bg-paper py-20 sm:py-28"
>
  <!-- Від md кадр віддзеркалено засобами CSS, без другого файлу, і поставлено
       на рівень початку тексту: верх кадру = верх заголовка. -->
  <div
    aria-hidden="true"
    class="pointer-events-none relative mx-5 mb-6 w-auto md:absolute md:top-28 md:right-[6%] md:mx-0 md:mb-0 md:w-[46%] md:-scale-x-100"
  >
    <Image
      src={cutout}
      alt=""
      widths={[420, 640, 900]}
      sizes="(max-width: 767px) 90vw, 40vw"
      format="webp"
      loading="lazy"
      class="h-auto w-full object-contain"
    />
  </div>

  <div class="relative mx-auto max-w-[78rem] px-5 sm:px-8">
    <div class="reveal max-w-[34rem]">
      <h2 class="text-h2 font-display font-medium text-ink">
        {intro.title}
      </h2>

      <div class="mt-7 flex flex-col gap-4 font-sans text-body text-ink/85">
        {intro.paragraphs.map((p) => <p>{p}</p>)}
      </div>

      <Cta
        source="intro"
        label="Обрати своє заняття"
        variant="quiet"
        class="mt-9"
      />
    </div>
  </div>
</section>
