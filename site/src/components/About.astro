---
import { Image } from "astro:assets";
import { about } from "../content/site";
import Cta from "./Cta.astro";
import photo from "../assets/photos/about-cutout.png";
---

<section
  id="pro-mene"
  class="scroll-mt-20 overflow-hidden bg-paper py-20 sm:py-28"
>
  <div
    class="mx-auto grid max-w-[78rem] items-start gap-12 px-5 sm:px-8 lg:grid-cols-[minmax(0,24rem)_minmax(0,1fr)] lg:gap-20"
  >
    <!-- Кадр на 30% більший за свою колонку і опущений: ліва частина навмисно
         виходить за межу сайту й зрізається. -->
    <figure class="reveal lg:order-1 lg:-mt-8 lg:-ml-[6rem] lg:w-[33rem] lg:max-w-none">
      <Image
        src={photo}
        alt="Оля Швед сидить зі складеними руками"
        widths={[500, 750, 1000]}
        sizes="(min-width: 1024px) 31rem, 100vw"
        format="webp"
        loading="lazy"
        class="h-auto w-full object-contain"
      />
    </figure>

    <div class="reveal lg:order-2">
      <h2 class="text-h2 font-display font-medium text-ink">
        {about.title}
      </h2>

      <div class="mt-7 flex max-w-[56ch] flex-col gap-4 font-sans text-body text-ink/85">
        {about.paragraphs.map((p) => <p>{p}</p>)}
      </div>

      <dl
        class="mt-10 grid gap-x-8 gap-y-6 border-t border-taupe/20 pt-8 sm:grid-cols-2"
      >
        {
          about.credentials.map((c) => (
            <div>
              <dt class="font-display text-[1.125rem] font-medium text-ink">
                {c.value}
              </dt>
              <dd class="mt-1 font-sans text-small text-taupe">{c.label}</dd>
            </div>
          ))
        }
      </dl>

      <Cta source="about" label="Приєднатися до заняття" variant="quiet" class="mt-10" />
    </div>
  </div>
</section>
