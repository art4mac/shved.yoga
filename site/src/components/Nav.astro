---
import { nav, meta, bot, cta } from "../content/site";
---

<header
  class="sticky top-0 z-40 border-b border-taupe/12 bg-paper/88 backdrop-blur-md"
>
  <div
    class="mx-auto flex max-w-[78rem] items-center justify-between gap-6 px-5 py-3.5 sm:px-8"
  >
    <a
      href="/"
      class="font-display text-[1.0625rem] font-medium tracking-tight text-ink"
    >
      {meta.brand}
    </a>

    <nav aria-label="Основне меню" class="hidden lg:block">
      <ul class="flex items-center gap-7">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="font-sans text-small text-taupe transition-colors hover:text-ink"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- На вузьких екранах кнопки в шапці немає: вона переповнювала рядок,
         а той самий CTA стоїть на першому екрані нижче. -->
    <a
      href={bot("nav")}
      data-cta="nav"
      target="_blank"
      rel="noopener"
      class="hidden shrink-0 bg-copper px-5 py-2.5 font-sans text-small font-medium text-paper transition-colors hover:bg-ink sm:inline-block"
    >
      {cta.label}
    </a>
  </div>
</header>
