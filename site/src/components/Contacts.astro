---
import { kontakty, napriamy } from "../content/site";
import Cta from "./Cta.astro";

const mapQuery = encodeURIComponent(`${kontakty.address}, ${kontakty.city}`);
/**
 * Карту вставляємо посиланням, а не iframe: вбудована мапа Google ставить
 * cookies, а ми свідомо живемо без cookie-банера.
 */
const mapHref = `https://www.google.com/maps/search/?api=1&query=${mapQuery}`;
---

<section id="kontakty" class="scroll-mt-20 bg-paper py-20 sm:py-28">
  <div class="mx-auto max-w-[78rem] px-5 sm:px-8">
    <div class="grid gap-14 lg:grid-cols-2 lg:gap-20">
      <div class="reveal">
        <p class="font-sans text-eyebrow uppercase text-copper">
          {kontakty.eyebrow}
        </p>
        <h2 class="mt-4 text-h2 font-display font-medium text-ink">
          {kontakty.title}
        </h2>

        <dl class="mt-9 flex flex-col gap-6">
          <div>
            <dt class="font-sans text-eyebrow uppercase text-taupe">Адреса</dt>
            <dd class="mt-2 font-display text-h3 font-medium text-ink">
              {kontakty.address}
            </dd>
            <dd class="mt-1.5 font-sans text-body text-taupe">
              простір{" "}
              <a
                href={kontakty.venue.href}
                target="_blank"
                rel="noopener"
                class="text-ink underline decoration-copper decoration-1 underline-offset-4 hover:text-copper"
                >{kontakty.venue.name}</a
              >, {kontakty.city}
            </dd>
            <dd class="mt-3">
              <a
                href={mapHref}
                target="_blank"
                rel="noopener"
                class="font-sans text-small text-ink underline decoration-taupe/50 decoration-1 underline-offset-4 hover:decoration-copper"
                >Відкрити на карті &#8594;</a
              >
            </dd>
          </div>

          {
            kontakty.transit && (
              <div>
                <dt class="font-sans text-eyebrow uppercase text-taupe">
                  Як дістатися
                </dt>
                <dd class="mt-2 font-sans text-body text-ink/85">
                  {kontakty.transit}
                </dd>
              </div>
            )
          }

          {
            kontakty.parking && (
              <div>
                <dt class="font-sans text-eyebrow uppercase text-taupe">
                  Паркування
                </dt>
                <dd class="mt-2 font-sans text-body text-ink/85">
                  {kontakty.parking}
                </dd>
              </div>
            )
          }

          <div>
            <dt class="font-sans text-eyebrow uppercase text-taupe">Зв'язок</dt>
            <dd class="mt-2 flex flex-wrap gap-x-6 gap-y-2 font-sans text-body">
              <a
                href={kontakty.instagram}
                target="_blank"
                rel="noopener"
                class="text-ink underline decoration-taupe/50 decoration-1 underline-offset-4 hover:decoration-copper"
                >Instagram</a
              >
              <a
                href={kontakty.telegram}
                target="_blank"
                rel="noopener"
                class="text-ink underline decoration-taupe/50 decoration-1 underline-offset-4 hover:decoration-copper"
                >Telegram</a
              >
            </dd>
          </div>
        </dl>
      </div>

      <div class="reveal lg:pt-16">
        <h3 class="max-w-[24ch] text-h2 font-display font-medium text-ink">
          {kontakty.final.title}
        </h3>
        <div class="mt-6 flex max-w-[46ch] flex-col gap-4 font-sans text-body text-ink/85">
          {kontakty.final.paragraphs.map((p) => <p>{p}</p>)}
        </div>

        <div class="mt-9 flex flex-wrap gap-4">
          {
            napriamy.map((n) => (
              <Cta
                source={`final-${n.id}`}
                napriam={n.id}
                label={n.ctaLabel}
                variant={n.id === "hatha" ? "solid" : "quiet"}
              />
            ))
          }
        </div>

        <p class="mt-8 font-display text-lead text-taupe">
          {kontakty.final.signature}
        </p>
      </div>
    </div>
  </div>
</section>
