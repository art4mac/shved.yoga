---
import { getImage } from "astro:assets";
import { hero } from "../content/site";
import Cta from "./Cta.astro";
import heroWide from "../assets/photos/hero-wide.jpg";
import heroMid from "../assets/photos/hero-mid.jpg";
import heroTall from "../assets/photos/hero-tall.jpg";

/**
 * Арт-дирекшн: три окремі кропи одного кадру, а не один розтягнутий.
 * Вертикальний вирізаний так, щоб нога виходила за край рамки, а не впиралась.
 *
 * Текст лежить поверх фото, тому під ним завжди є підкладка з паперового
 * кольору: ліва на широких екранах, верхня на вузьких. Без неї заголовок
 * потрапляє на чорний одяг і зникає.
 */
const sources = await Promise.all(
  (
    [
      { img: heroTall, media: "(max-width: 639px)", widths: [600, 900, 1200] },
      {
        img: heroMid,
        media: "(min-width: 640px) and (max-width: 1023px)",
        widths: [900, 1400, 1800],
      },
      { img: heroWide, media: "(min-width: 1024px)", widths: [1280, 1920, 2560] },
    ] as const
  ).flatMap((entry) =>
    (["avif", "webp"] as const).map(async (format) => {
      const result = await getImage({
        src: entry.img,
        widths: [...entry.widths],
        format,
      });
      return {
        media: entry.media,
        type: `image/${format}`,
        srcset: result.srcSet.attribute,
      };
    }),
  ),
);

const fallback = await getImage({ src: heroMid, width: 1400, format: "jpeg" });
---

<section class="relative isolate overflow-hidden bg-greige">
  <picture>
    {
      sources.map((s) => (
        <source media={s.media} type={s.type} srcset={s.srcset} />
      ))
    }
    <img
      src={fallback.src}
      alt="Оля Швед виконує асану на килимку в студії"
      width={fallback.attributes.width}
      height={fallback.attributes.height}
      fetchpriority="high"
      decoding="sync"
      class="absolute inset-0 h-full w-full object-cover object-[72%_center] sm:object-center"
    />
  </picture>

  <!-- На широких екранах текст лежить у чистій лівій зоні кадру, тому
       достатньо м'якого градієнта, який не доходить до фігури. -->
  <div
    aria-hidden="true"
    class="absolute inset-y-0 left-0 hidden w-[52%] bg-gradient-to-r from-paper from-30% via-paper/35 via-68% to-transparent lg:block"
  >
  </div>

  <div
    class="relative mx-auto flex min-h-[78svh] max-w-[78rem] items-end sm:items-center lg:min-h-[86svh] lg:items-start lg:pt-[9svh]"
  >
    <!-- На вузьких екранах — паперова плашка з чітким краєм замість розмитої
         пелени: градієнт не давав тексту контрасту над килимком. Плашка внизу,
         щоб над нею було видно фігуру, а не одну кисть. -->
    <div
      class="max-w-[34ch] bg-paper px-5 py-9 sm:max-w-[26ch] sm:bg-transparent sm:px-8 sm:py-20 lg:max-w-[36ch] lg:py-0"
    >
      <h1 class="text-display font-display font-medium text-ink">
        {hero.title}
      </h1>

      <p class="mt-6 max-w-[32ch] font-sans text-lead text-ink/90">
        {hero.lead}
      </p>
      <p class="mt-2.5 max-w-[34ch] font-sans text-body text-taupe">
        {hero.sub}
      </p>

      <Cta source="hero" withNote class="mt-8" />
    </div>
  </div>
</section>

<!-- Факти окремою смугою на папері: поверх фото вони були нечитабельні. -->
<div class="border-b border-taupe/20 bg-paper">
  <ul
    class="mx-auto flex max-w-[78rem] flex-wrap items-center gap-x-3 gap-y-2 px-5 py-4 font-sans text-[0.6875rem] uppercase tracking-[0.11em] text-taupe sm:px-8 sm:text-eyebrow"
  >
    {
      hero.facts.map((fact, i) => (
        <li class="flex items-center gap-3">
          {i > 0 && (
            <span aria-hidden="true" class="text-taupe/45">
              &#8226;
            </span>
          )}
          <span>{fact}</span>
        </li>
      ))
    }
  </ul>
</div>
