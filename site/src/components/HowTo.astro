---
import { yakZapysatys } from "../content/site";

/** Нумерація тут виправдана: це справжня послідовність із трьох кроків. */
---

<section class="bg-paper py-20 sm:py-28">
  <div class="mx-auto max-w-[78rem] px-5 sm:px-8">
    <header class="reveal max-w-[30ch]">
      <h2 class="text-h2 font-display font-medium text-ink">
        {yakZapysatys.title}
      </h2>
    </header>

    <ol class="reveal mt-12 grid gap-10 sm:grid-cols-3 sm:gap-8">
      {
        yakZapysatys.steps.map((step, i) => (
          <li class="border-t border-taupe/25 pt-5">
            <span class="font-display text-clock font-medium text-copper">
              {i + 1}
            </span>
            <h3 class="mt-3 text-h3 font-display font-medium text-ink">
              {step.title}
            </h3>
            <p class="mt-2.5 font-sans text-body text-ink/80">{step.text}</p>
          </li>
        ))
      }
    </ol>

    <p class="reveal mt-10 font-sans text-small text-taupe">
      {yakZapysatys.outro}
    </p>
  </div>
</section>
